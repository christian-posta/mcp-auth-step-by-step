{
  "realm": {
    "name": "mcp-realm",
    "displayName": "MCP Server Realm",
    "enabled": true,
    "accessTokenLifespan": 3600,
    "accessTokenLifespanForImplicitFlow": 1800,
    "ssoSessionIdleTimeout": 3600,
    "ssoSessionMaxLifespan": 72000,
    "offlineSessionIdleTimeout": 2592000
  },
  "clients": [
    {
      "clientId": "mcp-test-client",
      "name": "MCP Test Client",
      "type": "public",
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "assignedScopes": {
        "default": ["echo-mcp-server-audience"],
        "optional": ["mcp:read", "mcp:tools", "mcp:prompts", "mcp:tools:echo", "mcp:tools:time", "mcp:tools:calc", "mcp:tools:admin"]
      }
    },
    {
      "clientId": "echo-mcp-server",
      "name": "Echo MCP Server",
      "type": "confidential",
      "enabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "tokenExchange": {
        "enabled": true
      },
      "clientSecret": "PLOs4j6ti521kb5ZVVVwi5GWi9eDYTwq",
      "roles": [
        {
          "name": "tools",
          "description": "Can call all tools (hierarchical access)"
        },
        {
          "name": "tools-echo",
          "description": "Can call the echo tool"
        },
        {
          "name": "tools-time",
          "description": "Can call the get_time tool"
        },
        {
          "name": "tools-calc",
          "description": "Can call the calculate tool"
        },
        {
          "name": "tools-admin",
          "description": "Can call the system_info tool (admin only)"
        },
        {
          "name": "prompts",
          "description": "Can call prompts"
        },
        {
          "name": "read-only",
          "description": "Can read resources"
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "echo-mcp-server-audience",
      "description": "Adds echo-mcp-server to token audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "mappers": [
        {
          "name": "echo-mcp-server-mapper",
          "type": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "echo-mcp-server",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp:read",
      "description": "Read access to MCP resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "roles": [
        {
          "client": "echo-mcp-server",
          "role": "read-only"
        }
      ]
    },
    {
      "name": "mcp:tools",
      "description": "Access to execute ALL MCP tools (hierarchical)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "roles": [
        {
          "client": "echo-mcp-server",
          "role": "tools"
        }
      ]
    },
    {
      "name": "mcp:tools:echo",
      "description": "Access to execute the echo tool",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "roles": [
        {
          "client": "echo-mcp-server",
          "role": "tools-echo"
        }
      ]
    },
    {
      "name": "mcp:tools:time",
      "description": "Access to execute the get_time tool",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "roles": [
        {
          "client": "echo-mcp-server",
          "role": "tools-time"
        }
      ]
    },
    {
      "name": "mcp:tools:calc",
      "description": "Access to execute the calculate tool",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "roles": [
        {
          "client": "echo-mcp-server",
          "role": "tools-calc"
        }
      ]
    },
    {
      "name": "mcp:tools:admin",
      "description": "Access to execute the system_info tool (admin only)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "roles": [
        {
          "client": "echo-mcp-server",
          "role": "tools-admin"
        }
      ]
    },
    {
      "name": "mcp:prompts",
      "description": "Access to MCP prompts",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "roles": [
        {
          "client": "echo-mcp-server",
          "role": "prompts"
        }
      ]
    }
  ],
  "users": [
